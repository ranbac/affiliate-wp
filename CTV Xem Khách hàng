/**
 * Thêm cột "Khách hàng" vào:
 * Affiliate Area > Referrals
 *
 * Dành cho:
 * - AffiliateWP
 * - Paid Memberships Pro
 *
 * Chỉ hiển thị tên khách hàng.
 * Không hiển thị email, số điện thoại hoặc thông tin cá nhân khác.
 */


/**
 * 1. Thêm tiêu đề cột.
 */
add_action( 'affwp_referrals_dashboard_th', function() {

	echo '<th class="referral-customer-name">Khách hàng</th>';

} );


/**
 * 2. Thêm tên khách hàng vào từng Referral.
 */
add_action( 'affwp_referrals_dashboard_td', function( $referral ) {

	$name = '';

	/*
	 * Chỉ xử lý Referral của Paid Memberships Pro.
	 */
	$context = ! empty( $referral->context )
		? (string) $referral->context
		: '';

	if ( 'pmp' === $context && class_exists( 'MemberOrder' ) ) {

		/*
		 * AffiliateWP lưu PMPro Order ID
		 * trong trường Reference.
		 */
		$order_id = ! empty( $referral->reference )
			? absint( $referral->reference )
			: 0;

		if ( $order_id > 0 ) {

			$order = new MemberOrder( $order_id );

			if ( ! empty( $order->user_id ) ) {

				$user_id = absint( $order->user_id );

				/*
				 * Ưu tiên lấy Họ + Tên.
				 */
				$first_name = trim(
					(string) get_user_meta(
						$user_id,
						'first_name',
						true
					)
				);

				$last_name = trim(
					(string) get_user_meta(
						$user_id,
						'last_name',
						true
					)
				);

				$name = trim( $first_name . ' ' . $last_name );


				/*
				 * Nếu chưa nhập Họ/Tên,
				 * dùng Display Name của WordPress.
				 */
				if ( '' === $name ) {

					$user = get_userdata( $user_id );

					if ( $user ) {
						$name = trim(
							(string) $user->display_name
						);
					}
				}
			}
		}
	}

	/*
	 * Không tìm được tên thì chỉ hiện dấu —
	 * Không fallback sang email/username.
	 */
	if ( '' === $name ) {
		$name = '—';
	}

	echo '<td class="referral-customer-name" data-th="Khách hàng">';
	echo esc_html( $name );
	echo '</td>';

} );


/**
 * 3. CSS nhỏ để cột tên khách hàng dễ đọc.
 */
add_action( 'wp_head', function() {

	if ( ! is_user_logged_in() ) {
		return;
	}

	?>
	<style>
		#affwp-affiliate-dashboard-referrals
		.referral-customer-name {
			white-space: nowrap;
		}

		#affwp-affiliate-dashboard-referrals th.referral-customer-name {
			font-weight: 600;
		}
	</style>
	<?php

} );
